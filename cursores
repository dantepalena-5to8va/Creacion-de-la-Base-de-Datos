SELECT stock FROM Productos

DECLARE stok INT

OPEN cursor_actualizador
CREATE PROCEDURE actualizar_stock() //
BEGIN
FETCH NEXT FROM cursor_actualizador INTO stok
BEGIN
DECLARE CONTINUE HANDLER FOR NOT FOUND LoOP7 Boolean = false
WHILE LoOP7
BEGIN

IF stok < 5
THEN
UPDATE Productos SET stock = stock + 10
ELSE
IF stok >= 5 AND stok < 20
THEN
UPDATE Productos SET stock = stock + 5
END IF
END IF

FETCH NEXT FROM cursor_actualizar INTO stok
END
END WHILE
END
END //

CLOSE cursor_actualizador
DEALLOCATE cursor_actualizador


