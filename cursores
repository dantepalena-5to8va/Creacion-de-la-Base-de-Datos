DECLARE CURSOR cursor_clasificador FOR
SELECT descripcion, precio FROM Productos

DECLARE descrip VARCHAR(60)
DECLARE valor DECIMAL(7,2)

OPEN cursor_clasificador
CREATE PROCEDURE clasificador_productos() //
BEGIN
FETCH NEXT FROM cursor_clasificador INTO descrip, valor
BEGIN
DECLARE CONTINUE HANDLER FOR NOT FOUND LooP4 Boolean = false
WHILE LooP4
BEGIN

SELECT CONCAT("Producto: ", descrip)
SELECT CONCAT("Precio: ", valor)
IF (valor < 10000)
THEN SELECT CONCAT("Categoria: BARATO")
ELSE
IF (valor > 10000 && < 50000)
THEN SELECT CONCAT("Categoria: MEDIO")
ELSE
IF (valor > 50000)
THEN SELECT CONCAT("Categoria: CARO")
END IF
END IF
END IF

FETCH NEXT FROM cursor_clasificador INTO descrip, valor
END
END WHILE
END
END //
CLOSE cursor_clasificador
DEALLOCATE cursor_clasificador


