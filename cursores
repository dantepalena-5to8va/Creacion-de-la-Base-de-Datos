DECLARE CURSOR valor_stocksss FOR
SELECT precio, stock FROM Productos

DECLARE @precio DECIMAL(7,2)
DECLARE @stock INT
DELCARE total DECIMAL(10,2)

OPEN valor_stocksss
CREATE PROCEDURE valor_stock() //
BEGIN
FETCH NEXT FROM valor_stocksss INTO @precio, @stock
BEGIN
DECLARE CONTINUE HANDLER FOR NOT FOUND LooP Boolean = false
WHILE LooP
BEGIN

DECLARE subtotal = 0 DECIMAL(10,2)
SELECT precio AS "Precio", stock AS "Stock", subtotal AS "Subtotal"
SET subtotal = subtotal + (stock * precio)
SET total += subtotal

FETCH NEXT FROM valor_stocksss INTO @precio, @stock
END
END WHILE

SELECT total AS "Valor_Inventario"

END
END //
CLOSE valor_stocksss
DEALLOCATE valor_stocksss


