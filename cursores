DECLARE CURSOR cursor_aumentador FOR
SELECT precio FROM Productos

DECLARE valor DECIMAL(7,2)

OPEN cursor_aumentador
CREATE PROCEDURE aumentar_precio() //
BEGIN
FETCH NEXT FROM cursor_aumentador INTO valor
BEGIN
DECLARE CONTINUE HANDLER FOR NOT FOUND LoOp6 Boolean = false
WHILE LoOp6
BEGIN

IF valor < 10000
THEN
UPDATE Productos SET precio = valor * 1.20
ELSE
UPDATE Productos IF precio >= 10000
THEN
UPDATE Productos SET precio = valor * 1.10
END IF
END IF

FETCH NEXT FROM cursor_aumentador INTO valor
END
END WHILE
END
END //
CLOSE cursor_aumentador
DEALLOCATE cursor_aumentador


