DECLARE CURSOR subtotal_productos FOR
  SELECT precio, stock FROM Productos

  DECLARE @precio DECIMAL(7,2)
  DECLARE @stock INT

  OPEN subtotal_productos
CREATE PROCEDURE listar_productos() //
BEGIN

  FETCH NEXT FROM subtotal_productos INTO @precio, @stock
    BEGIN
      DECLARE CONTINUE HANDLER FRO NOT FOUND LooP Boolean = false
        WHILE LooP
          BEGIN
            DECLARE subtotal = 0 DECIMAL(10,2)
              SELECT precio AS "Precio", stock AS "Stock", subtotal AS "Subtotal"
              SET subtotal = subtotal + (stock * precio)
            FETCH NEXT FROM subtotal INTO @precio, @stock
          END
        END WHILE
    END
END //
CLOSE subtotal_productos
DEALLOCATE subtotal_productos;

