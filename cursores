DECLARE CURSOR cursor_listador FOR
SELECT id, cliente, producto, cant, fecha FROM Compras 

DECLARE @id INT
DECLARE @cliente INT
DECLARE @producto INT
DECLARE @cant INT
DECLARE @fecha DATE

OPEN cursor_listador
CREATE PROCEDURE listar() //
BEGIN
FETCH NEXT FROM cursor_listador INTO @id, @cliente, @producto, @cant, @fecha
BEGIN
DECLARE CONTINUE HANDLER FOR NOT FOUND ULoop Boolean = false
WHILE ULoop
BEGIN

SELECT CONCAT("Compra #", @id)
SELECT CONCAT("Cliente: ", (SELECT nombre FROM Clientes WHERE id = @cliente)
SELECT CONCAT("Producto: ", (SELECT decripcion FROM Productos WHERE id = @producto)
SELECT CONCAT("Cantidad: ", @cant)
SELECT CONCAT("Fecha: ", @fecha)

FETCH NEXT FROM cursor_listador INTO @id, @cliente, @producto, @cant, @fecha
END
END WHILE
END
END //

CLOSE cursor_listador
DALLOCATE cursor_listador
