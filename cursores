DECLARE CURSOR zero_stock FOR
SELECT * FROM Productos

DECLARE @id INT
DECLARE descrip VARCHAR(60)
DECLARE marc VARCHAR(40)
DECLARE preci DECIMAL(7,2)
DECLARE stok INT

OPEN zero_stock
CREATE PROCEDURE cero_stok() //
BEGIN
FETCH NEXT FROM zero_stock INTO @id, descrip, marc, preci, stok
BEGIN
DECLARE CONTINUE HANDLER FOR NOT FOUND LoOP3 Boolean = false
WHILE LoOP3
BEGIN

IF stok == 0
THEN
SELECT @id AS "ID", descrip AS "Descripcion", marc AS "Marca", preci AS "Precio", stok AS "Stock" 

FETCH NEXT FROM zero_stock INTO @id, descrip, marc, preci, stok
END
END WHILE
END
END //
CLOSE zero_stock
DEALLOCATE zero_stock


