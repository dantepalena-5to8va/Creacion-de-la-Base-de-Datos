USE biblioteca
CREATE TABLE Multas(UsuarioID INT, PrecioMulta DECIMAL(10,2), FOREING KEY (UsuarioID) REFERENCES Usuarios(UsuarioID))


DELIMITER //
CREATE FUNCTION crear_multa(FechaDevolucion DATE)
RETURNS DECIMAL(10,2)

BEGIN
DECLARE fechaD DATE
SET fechaD = FechaDevolucion
DECLARE multa DECIMAL(10,2)

IF(fechaD > CURDATE())
THEN
SET multa = multa + 1000
INSERT INTO Multas VALUES((SELECT UsuarioID FROM Prestamos WHERE FechaDevolucion = fechaD), multa)
RETURN multa
END IF;

END //
DELIMITER;


