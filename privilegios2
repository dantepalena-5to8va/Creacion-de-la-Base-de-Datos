DELIMITER //
CREATE FUNCTION verificacion1(UsuarioID INT, IDLibro INT)
RETURNS VARCHAR(255)

BEGIN
IF(UsuarioID IN(SELECT UsuarioID FROM Usuarios) AND IDLibro IN(SELECT IDLibro FROM Ejemplares))
THEN
RETURN "existen"
ELSE
RETURN "no"
END IF;

END //
DELIMITER;

DELIMITER //
CREATE FUNCTION verificacion2(IDLibro INT)
RETURNS VARCHAR(255)

BEGIN
DECLARE ejemplar INT
SET ejemplar = IDLibro

IF (SELECT Estado FROM Ejemplares WHERE IDLibro = ejemplar) == "DISPONIBLE"
THEN
RETURN "disponible"
ELSE
RETURN "no"
END IF;

END //
DELIMITER;

DELIMITER //
CREATE FUNCTION verificacion3(UsuarioID INT)
RETURNS VARCHAR(255)

BEGIN
DECLARE usuario INT
SET usuario = UsuarioID

IF COUNT(SELECT UsuarioID FROM Prestamos WHERE UsuarioID = usuario)) < 3
THEN
RETURN "menos"
ELSE
RETURN "mas"
END IF;

END //
DELIMITER;

DELIMITER //
CREATE FUNCTION verificacion4(UsuarioID)
RETURNS VARCHAR(255)

BEGIN
DECLARE usuario INT
SET usuario = UsuarioID

IF usuario NOT IN(SELECT UsuarioID FROM Multas)
THEN
RETURN "puede"
ELSE
RETURN "no_puede"
END IF;

END //
DELIMITER;

DELIMITER //
CREATE PROCEDURE RegistrarPrestamo (IN UsuarioID INT, IDLibro INT)

BEGIN

IF verificacion1(UsuarioID, IDLibro) == "existen" AND verificacion2(IDLibro) == "disponible" AND
verificacion3(UsuarioID) == "menos" AND verificacion4(UsuarioID) == "puede"
THEN
INSERT INTO Prestamos VALUES(PrestamoID, IDLibro, UsuarioID, CURDATE(), '2026-10-21')
END IF;

END //
DELIMITER;


