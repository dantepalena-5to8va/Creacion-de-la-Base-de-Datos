USE biblioteca
CREATE TABLE Ejemplares(IDLibro INT, Estado VARCHAR(255), FOREING KEY (LibroID) REFERENCES Libros(LibroID))

DELIMITER //
CREATE TRIGGER solo_disponible
BEFORE INSERT ON Prestamos
FOR EACH ROW

BEGIN
IF (SELECT E.Estado FROM Prestamos P JOIN Ejemplares E ON P.LibroID = E.IDLibro) != "DISPONIBLE"
THEN
RAISE EXEPTION "No se puede prestar, no esta disponible"
END IF;

END //
DELIMITER;

DELIMITER //
CREATE TRIGGER pres_ejem
AFTER INSERT ON Prestamos
FOR EACH ROW

BEGIN
IF (SELECT E.Estado FROM Prestamos P JOIN Ejemplares E ON P.LibroID = E.IDLibro) == "DISPONIBLE"
THEN
UPDATE Ejemplares SET Estado = "PRESTADO" WHERE IDLibro = (SELECT LibroID FROM Prestamos)
END IF;

END //
DELIMITER;

DELIMITER //
CREATE TRIGGER devo_ejem
AFTER INSERT ON Devoluciones
FOR EACH ROW

BEGIN 
IF (SELECT E.Estado FROM Devoluciones D JOIN Ejemplares E ON D.LibroID = E.IDLibro) == "PRESTADO"
THEN
UPDATE Ejemplares SET Estado = "DISPONIBLE" WHERE IDLibro = (SELECT LibroID FROM Prestamos)
END IF;

END //
DELIMITER;

DELIMTER //
CREATE TRIGGER con_ejem
BEFORE DELETE ON Libros
FOR EACH ROW

BEGIN
IF LibroID IN (SELECT IDLibro FROM Ejemplares)
THEN
RAISE EXEPTION "El libro tiene ejemplares disponible"
END IF;

END //
DELIMTER;

DELIMITER //
CREATE TRIGGER ejem_historicos
BEFORE DELETE ON Ejemplares
FOR EACH ROW

