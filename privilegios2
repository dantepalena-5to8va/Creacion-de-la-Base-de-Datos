USE biblioteca
CREATE TABLE Ejemplares(LibroID INT, Estado VARCHAR(255), FOREING KEY (LibroID) REFERENCES Libros(LibroID))

DELIMITER //
CREATE TRIGGER solo_disponible
BEFORE INSERT ON Prestamos
FOR EACH ROW

BEGIN
IF (SELECT E.Estado FROM Prestamos P JOIN Ejemplares E ON P.LibroID = E.LibroID) != "DISPONIBLE"
THEN
RAISE EXEPTION "No se puede prestar, no esta disponible"
END IF;

END //
DELIMITER;

DELIMITER //
CREATE TRIGGER pres_ejem
AFTER INSERT ON Prestamos
FOR EACH ROW

BEGIN
IF (SELECT E.Estado FROM Prestamos P JOIN Ejemplares E ON P.LibroID = E.LibroID) == "DISPONIBLE"
THEN
UPDATE Ejemplares SET Estado = "PRESTADO"
END IF;

END //
DELIMITER;

