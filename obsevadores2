DELIMITER //
CREATE TRIGGER libros_perdidos
AFTER UPDATE ON Prestamos
FOR EACH ROW

BEGIN
IF FechaDevolucion < CURDATE()
THEN
IF LibroID = (SELECT LibroID FROM Libros)
THEN
INSERT INTO LibrosPerdidos VALUES(LibroID, Titulo, AutorID, GeneroID, AnioPublicacion, ISBN)
END IF;
END IF;

END //
DELIMITER;


