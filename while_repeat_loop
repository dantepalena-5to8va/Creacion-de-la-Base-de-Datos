DELIMITER //
CREATE FUNCTION clasico(ID_Libro INT)
RETURNS INT

BEGIN

IF((SELECT DATEDIFF(years, AnioPublicacion, CURDATE())FROM Libros WHERE LibroID = ID_Libro) > 50)
THEN
RETURN "clasico"
ELSE
RETURN "clasicon't"

END //
DELIMITER;

DELIMITER //
CREATE PROCEDURE clasico_clasicon't(ID_Libro INT)

BEGIN

DECLARE N INT
SET N = COUNT(Libros)

DECLARE X INT
SET X = 0
WHILE X <= N

SELECT Titulo, clasico(ID_Libro) FROM Libros
SET X = X + 1

END WHILE;
END //
DELIMITER;


