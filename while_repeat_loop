CREATE FUNCTION cantidad_prestamos(ID_Libro INT)
RETURNS INT

BEGIN
DECLARE cant INT

SELECT COUNT(LibroID) INTO cant FROM Prestamos WHERE LibroID = ID_Libro
RETURN cant

END //
DELIMITER;

