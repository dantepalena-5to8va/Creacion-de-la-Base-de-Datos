CREATE PROCEDURE prestamos_x_cliente(IN IDUsuario INT, N INT)

BEGIN

DECLARE X INT

WHILE X <= N DO
SELECT FechaPrestamo, FechaDevolucion FROM Prestamos WHERE UsuarioID = IDUsuario
SET X = X + 1
END WHILE;
END //
