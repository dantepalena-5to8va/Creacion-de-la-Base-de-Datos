DECALRE CURSOR subtotal_x_region FOR
SELECT poblacion, region FROM Provincias

DECLARE pobla INT
DECLARE reg VARCHAR(255)

OPEN subtotal_x_region

FECTH NEXT FROM subtotal_x_region INTO pobla, reg
BEGIN
DECLARE CONTINUE HANDLER FOR NOT FOUND LOoP11 Boolean = false
WHILE LOoOP11
BEGIN

DECLARE subtotalR INT
SET subtotalR = (SELECT poblacion FROM Provincias GROUP BY region DESC)

SELECT reg AS "Region", subtotalR AS "Poblacion" ORDER BY subtotalR DESC

FECTH NEXT FROM subtotal_x_region INTO pobla, reg
END
END WHILE
END

CLOSE subtotal_x_region
DEALLOCATE subtotal_x_region


