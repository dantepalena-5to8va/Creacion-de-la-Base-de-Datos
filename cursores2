DECLARE CURSOR cursor_ortografia FOR
SELECT nombre FROM Clientes

DECLARE @nombre VARCHAR(255)

OPEN cursor_ortografia

FETCH NEXT FROM cursor_ortografia INTO @nombre
BEGIN
DECLARE CONTINUE HANDLER FOR NOY FOUND LoOP10 Boolean = false
WHILE LoOP10
BEGIN

UPDATE Clientes SET nombre = UPPER(SUBTRING(@nombre, 0, 1))

FETCH NEXT FROM cursor_ortografia INTO @nombre
END
END WHILE
END

CLOSE cursor_ortografia
DEALLOCATE cursor_ortografia


