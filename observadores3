USE biblioteca
CREATE TABLE RegistrosT(RegistroID INT PRIMARY KEY AUTO_INCREMENT, LibroID INT TituloNuevo VARCHAR(255),
TituloViejo VARCHAR(255), FOREING KEY LibroID REFERENCES Libros(LibroID))

DELIMITER //
CREATE TRIGGER registro_titulos
BEFORE UPDATE ON Libros
FOR EACH ROW

BEGIN
IF NEW(Titulo) <> OLD(Titulo)
THEN
INSERT INTO RegistrosT VALUES(RegistroID, LibroID, NEW(Titulo), OLD(Titulo))
END IF;

END //
DELIMITER;

