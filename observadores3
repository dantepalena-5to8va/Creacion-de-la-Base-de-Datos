DELIMITER //
CREATE TRIGGER no_mas_libros
BEFORE INSERT ON Prestamos
FOR EACH ROW

BEGIN
DECLARE ID INT
ID = UsuarioID
IF COUNT(SELECT UsuarioID FROM Prestamos WHERE UsuarioId = ID) > 3
THEN
RAISE EXEPTION 'No puede realizar mas prestamos'
END IF;

END //
DELIMITER;

