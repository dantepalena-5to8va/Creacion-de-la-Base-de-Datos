DELIMITER //
CREATE TRIGGER no_prestar
BEFORE INSERT ON Prestamos
FOR EACH ROW

BEGIN
IF LibroID IN(SELECT LibroID FROM Prestamos) && LibroID IN(SELECT LibroID FROM Prestamos WHERE FechaDevolucion > CURDATE())
THEN
RAISE EXEPTION 'No se puede prestar ese libro'
END IF;

END //
DELIMITER;

