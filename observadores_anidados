DELIMITER //
CREATE FUNCTION titulo_libro(ID_Libro INT)
RETURNS VARCHAR

BEGIN
DECLARE titulo VARCHAR(255)

SELECT Titulo INTO titulo FROM Libros WHERE LibroID = ID_Libro
RETURN titulo

END //
DELIMITER;

DELIMITER //
CREATE FUNCTION autor_libro(ID_Libro INT)
RETURNS VARCHAR

BEGIN
DECLARE autor VARCHAR(255)

SELECT A.Nombre INTO autor FROM Libros L JOIN Autores A ON L.LibroID = A.LibroID WHERE LibroID = ID_Libro
RETURN autor

END //
DELIMITER;

DELIMITER //
CREATE FUNCTION descripcion_libro(ID_Libro INT)
RETURNS VARCHAR

BEGIN
DECLARE descripcion VARCHAR(510)

descripcion = CONCAT(titulo_libro(ID_Libro) " - " autor_libro(ID_Libro))
RETURN descripcion

END //
DELIMITER;

DELIMITER //
CREATE TRIGGER insertar
BEFORE INSERT ON Prestamos
FOR EACH ROW

BEGIN
IF(SUBSTRING(descripcion_libro(ID_Libro), 1, 255) IN(SELECT Titulo FROM Libros))
THEN
INSERT INTO Auditorias VALUES(AudiID, LibroID)
END IF;

END //
DELIMITER;

