DELIMITER //
CREATE FUNCTION autor_nombre(ID_Autor INT)
RETURNS VARCHAR

BEGIN
DECLARE autor VARCHAR(255)

SELECT Nombre INTO autor FROM Autores WHERE AutorID = ID_Autor
RETURN autor

END //
DELIMITER;

DELIMITER //
CREATE FUNCTION descripcion_autor(ID_Autor INT)
RETURNS VARCHAR

BEGIN
DECLARE descripcion VARCHAR(510)

descripcion = CONCAT(autor_nombre(ID_Autor) " - " cantidad_libro_autor(ID_Autor) " libros registrados")
RETURN descripcion

END //
DELIMITER;

CREATE TRIGGER registrar_A
AFTER INSERT ON Libros
FOR EACH ROW

BEGIN

INSERT INTO Autores VALUES(AutorID, SUBSTRING(descripcion_autor(ID_Autor), 0, 255), Nacionalidad)
END //
DELIMITER;


