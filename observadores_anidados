CREATE FUNCTION cantidad_libro_autor(ID_Autor INT)
RETURNS INT

BEGIN
DECLARE cantidad INT

SELECT COUNT(LibroID) INTO cantidad FROM Autores WHERE AutorID = ID_Autor
RETURN cantidad

END //
DELIMITER;

DELIMITER //
CREATE FUNCTION año_libro(ID_Libro INT)
RETURNS INT

BEGIN

DECLARE año INT

SELECT DATEDIFF(years, AnioPublicacion, CURDATE()) INTO año FROM Libros WHERE LibroID = ID_Libro
RETURN año

END //
DELIMITER;

DELIMITER //
CREATE TRIGGER determinar
BEFORE INSERT ON Libros
FOR EACH ROW

BEGIN

IF(cantidad_libro_autor(ID_Autor) > 5 && año_libro(ID_Libro) > 50)
THEN
RETURN "El libro es un clasico"
END IF;

END //
DELIMITER;



