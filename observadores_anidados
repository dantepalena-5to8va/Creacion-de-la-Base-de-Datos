DELIMITER //
CREATE FUNCTION dias_prestamo(fechaPrestamo DATE, fechaDevolucion DATE)
RETURNS INT

BEGIN
DECLARE dias INT
dias = DATEDIFF(days, fechaDevolucion,fechaPrestamo)

RETURN dias
END //
DELIMITER;

DELIMITER //
CREATE TRIGGER registrar
BEFORE INSERT ON Prestamos
FOR EACH ROW

BEGIN
IF(dias_prestamo(fechaDevolucion,fechaPrestamo) > 30)
THEN
RAISE EXEPTION 'No se puede registrar porque son mas de 30 dias'
END IF;

END //
DELIMITER;

