DELIMITER //
CREATE FUNCTION nombre_libro(ID_Libro INT)
RETURNS VARCHAR

BEGIN
DECLARE nombre VARCHAR(255)

SELECT Titulo INTO nombre FROM Libros WHERE LibroID = ID_Libro
RETURN nombre

END //
DELIMITER;

DELIMITER //
CREATE TRIGGER prestado
BEFORE UPDATE ON Prestamos
FOR EACH ROW

BEGIN
IF(nombre_libro(ID_Libro) IN (SELECT L.Titulo FROM Libros L JOIN Prestamos P ON L.LibroID = P.LibroID WHERE P.LibroID = ID_Libro))
THEN
INSERT INTO Auditorias VALUES(AudiID, (SELECT LibroID FROM Libros WHERE Titulo = nombre_libro(ID_Libro)))
END IF;

END //
DELIMITER;


