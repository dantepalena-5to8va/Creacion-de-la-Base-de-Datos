DELIMITER //
CREATE TRIGGER cont_stock
BEFORE DELETE ON Productos
FOR EACH ROW

BEGIN
IF stock > 0
THEN
RAISE EXEPTION "El producto tiene stock"
END IF;

END //
DELIMITER;

CREATE VIEW productos_simples AS SELECT descripcion, stock, precio FROM Productos


CREATE USER 'empleado' @ 'localhost'
IDENTIFIED BY '1234emplea'

GRANT SELECT, UPDATE, DELETE, INSERT
ON productos_simples 
TO empleado


