CREATE TRIGGER observador_productos
AFTER UPDATE, DELETE, INSERT ON Productos
FOR EACH ROW

BEGIN
INSERT INTO Auditoria_C VALUES(CURDATE(), "Producto")

END //
DELIMITER;

