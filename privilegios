CREATE VIEW usuario_compra AS SELECT Clientes.id, Clientes.nombre, Clientes.apellido, Compras.id,
Compras.fecha, Compras.producto, Compras.cant FROM Clientes JOIN Compras ON
Clientes.id = Compras.cliente

CREATE USER 'gerente' @ 'localhost'
IDENTIFIED BY '1234gerent'

GRANT ALL PRIVILEGES
ON usuario_compra
TO gerente


